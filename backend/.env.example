# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (default, zero-config for local dev):
# DATABASE_URL=sqlite:///./data/bubble_tracker.db

# PostgreSQL (for production — uncomment and fill in):
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/bubble_tracker

# ── API Keys ──────────────────────────────────────────────────────────────────
# Required for ERP Valuation, M2 Liquidity, Credit Spreads, Energy Costs:
FRED_API_KEY=your_fred_api_key_here

# Optional — Narrative Dominance signal (Google Trends via SerpApi):
# SERPAPI_KEY=your_serpapi_key_here

# Optional — Narrative Dominance signal (Finnhub sentiment as proxy):
# FINNHUB_API_KEY=your_finnhub_api_key_here

# ── Frontend ──────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
