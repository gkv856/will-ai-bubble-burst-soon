# ── API Keys ──────────────────────────────────────────────────────────────────

# FRED (Federal Reserve Economic Data) — required.
# Used for: erp_valuation, m2_liquidity, credit_spreads, energy_costs
# Get a free key: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key_here

# SerpApi — used for the Retail FOMO signal (Google Trends search interest).
# Without it, retail_fomo stubs at 50 (neutral) and is marked stale.
# Free tier: 100 searches/month. https://serpapi.com/
SERPAPI_KEY=your_serpapi_key_here

# Google Gemini — used for the 3-day AI forecast (one call per pipeline run).
# Without it, AI predictions are skipped; everything else still works.
# Free tier — get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model id. Pinned "-preview" model names can get silently repointed to a
# paid-only model (this happened to gemini-3-pro-preview -> gemini-3.1-pro, which
# has a free-tier limit of 0). Prefer a rolling alias. Defaults to
# gemini-flash-latest in code if unset.
GEMINI_MODEL=gemini-flash-latest

# Finnhub — used as a proxy for the Narrative Dominance signal (news sentiment).
# Without it, narrative stubs at 0.4 (moderate) and is NOT marked stale.
# Free tier: https://finnhub.io/register
FINNHUB_API_KEY=your_finnhub_api_key_here
